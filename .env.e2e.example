# Environment for the Playwright E2E run (php artisan serve on 127.0.0.1:8010).
# Copy to .env.e2e (gitignored) and set APP_KEY (same as .env is fine).
# The database is a clone of `luvo`: npm run test:e2e-db
APP_NAME=Luvo
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luvo_e2e
DB_USERNAME=root
DB_PASSWORD=

# Array store (config/cache.php reads CACHE_DRIVER): the API throttle (200/min) resets on every request, an E2E run exceeds it
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8010

MAIL_MAILER=log
LOG_CHANNEL=single

# Test users, created by database/seeders/QaUserSeeder.php in the Playwright global setup
QA_ADMIN_EMAIL=qa-admin@luvo.test
QA_ADMIN_PASSWORD=
QA_USER_EMAIL=qa-user@luvo.test
QA_USER_PASSWORD=
QA_UNVERIFIED_EMAIL=qa-unverified@luvo.test
QA_UNVERIFIED_PASSWORD=
